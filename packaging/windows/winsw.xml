<service>
  <id>BifroxEventStore</id>
  <name>Bifrox Event Streaming Store</name>
  <description>Production Event Streaming Storage Engine Server (Kafka-compatible)</description>

  <!-- Path to executable -->
  <executable>%BASE%\bifrox.exe</executable>
  <arguments>--config %BASE%\server.properties</arguments>
  <workingdirectory>%BASE%</workingdirectory>

  <!-- Service Startup Type -->
  <startmode>Automatic</startmode>
  <delayedAutoStart>true</delayedAutoStart>

  <!-- Graceful Shutdown Settings -->
  <stopargument>--stop</stopargument>
  <stopparentprocessfirst>true</stopparentprocessfirst>
  <stoptimeout>30sec</stoptimeout>
  <sigkilltimeout>10sec</sigkilltimeout>

  <!-- Log Rotation & Log Directory Management -->
  <logpath>%BASE%\logs</logpath>
  <log mode="roll-by-size-time">
    <sizeThreshold>20971520</sizeThreshold> <!-- 20 MB -->
    <pattern>yyyyMMdd</pattern>
    <autoRollAtTime>00:00:00</autoRollAtTime>
    <zipOlder>true</zipOlder>
    <maxHistory>30</maxHistory>
  </log>

  <!-- Failure Recovery & Auto-Restart Policy -->
  <onfailure action="restart" delay="5 sec"/>
  <onfailure action="restart" delay="15 sec"/>
  <onfailure action="restart" delay="60 sec"/>
  <resetfailure>1 hour</resetfailure>

  <!-- Environment Variables -->
  <env name="RUST_LOG" value="info" />
  <env name="BIFROX_LOG_DIR" value="%BASE%\logs" />
</service>
